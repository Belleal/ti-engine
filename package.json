{
  "name": "ti-engine",
  "version": "1.2.10",
  "description": "The ti-engine is an open source, free to use\u2014both for personal and commercial projects\u2014framework for the creation of microservice-based solutions using node.js.",
  "author": "Boris Kostadinov <kostadinov.boris@gmail.com>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belleal/ti-engine.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint .",
