{
  "name": "@ti-engine/core",
  "version": "1.9.0",
  "description": "Microservice framework for Node.js: a Redis-backed message exchange with end-to-end call tracing, retries and tamper-evident message envelopes.",
  "keywords": [
    "microservices",
    "microservice-framework",
    "framework",
    "node",
    "redis",
    "ioredis",
    "messaging",
    "message-queue",
    "distributed-systems"
  ],
  "author": "Boris Kostadinov <kostadinov.boris@gmail.com>",
  "license": "GPL-3.0-or-later",
  "main": "./bin/start-instance.js",
  "type": "commonjs",
  "types": "./types/bin/start-instance.d.ts",
  "exports": {
    ".": {
      "types": "./types/bin/start-instance.d.ts",
      "default": "./bin/start-instance.js"
    },
    "./cache": {
      "types": "./types/utils/cache.d.ts",
      "default": "./utils/cache.js"
    },
    "./exceptions": {
      "types": "./types/utils/exceptions.d.ts",
      "default": "./utils/exceptions.js"
    },
    "./localization": {
      "types": "./types/utils/localization.d.ts",
      "default": "./utils/localization.js"
    },
    "./logger": {
      "types": "./types/utils/logger.d.ts",
      "default": "./utils/logger.js"
    },
    "./service-consumer": {
      "types": "./types/components/service-consumer.d.ts",
      "default": "./components/service-consumer.js"
    },
    "./service-instance": {
      "types": "./types/components/service-instance.d.ts",
      "default": "./components/service-instance.js"
    },
    "./service-provider": {
      "types": "./types/components/service-provider.d.ts",
      "default": "./components/service-provider.js"
    },
    "./tools": {
      "types": "./types/utils/tools.d.ts",
      "default": "./utils/tools.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "imports": {
    "#auditing": "./components/auditing.js",
    "#cache": "./utils/cache.js",
    "#config": "./utils/config.js",
    "#connection-observer": "./components/connection-observer.js",
    "#default-message-exchange": "./components/exchange/default/default-message-exchange.js",
    "#default-message-receiver": "./components/exchange/default/default-message-receiver.js",
    "#default-message-sender": "./components/exchange/default/default-message-sender.js",
    "#exceptions": "./utils/exceptions.js",
    "#labels": "./bin/localization/labels.json",
    "#localization": "./utils/localization.js",
    "#logger": "./utils/logger.js",
    "#message-dispatcher": "./components/exchange/message-dispatcher.js",
    "#message-exchange": "./components/exchange/message-exchange.js",
    "#message-handler": "./components/exchange/message-handler.js",
    "#message-memory-cache": "./components/exchange/message-memory-cache.js",
    "#message-observer": "./components/exchange/message-observer.js",
    "#message-receiver": "./components/exchange/message-receiver.js",
    "#message-sender": "./components/exchange/message-sender.js",
    "#message-tracer": "./components/exchange/message-tracer.js",
    "#redis-integration": "./integrations/redis-integration.js",
    "#service-caller": "./components/service-caller.js",
    "#service-consumer": "./components/service-consumer.js",
    "#service-executor": "./components/service-executor.js",
    "#service-instance": "./components/service-instance.js",
    "#service-provider": "./components/service-provider.js",
    "#settings": "./bin/settings.json",
    "#tools": "./utils/tools.js"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "lodash": "^4.18.1",
    "node-schedule": "^2.1.1"
  },
  "optionalDependencies": {
  },
  "files": [
    "bin/",
    "components/",
    "integrations/",
    "utils/",
    "types/",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belleal/ti-engine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Belleal/ti-engine/issues"
  },
  "homepage": "https://github.com/Belleal/ti-engine/tree/master/packages/core#readme",
  "engines": {
    "node": ">=20.12.0"
  }
}