{
  "name": "@ti-engine/web-content",
  "version": "0.1.0",
  "description": "A content-publishing engine for ti-engine sites: path-index routing, deny-by-default content visibility, SEO document rendering, feeds, and email capture, layered on @ti-engine/web-framework. NOTICE: This is a work in progress and the full architecture, design, and functionality are not yet available!",
  "keywords": [
    "cms",
    "content",
    "publishing",
    "static-site",
    "markdown",
    "seo",
    "ti-engine",
    "web-framework"
  ],
  "author": "Boris Kostadinov <kostadinov.boris@gmail.com>",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "exports": {
    "./schema": "./content/schema.js",
    "./loader": "./content/loader.js",
    "./repository": "./content/repository.js",
    "./transliterate": "./content/transliterate.js",
    "./taxonomy": "./content/taxonomy.js",
    "./markdown": "./content/markdown.js",
    "./sources": "./content/sources.js",
    "./html": "./render/html.js",
    "./render": "./render/document.js",
    "./sections": "./render/sections.js",
    "./editorial": "./render/editorial/index.js",
    "./routes": "./routes/index.js",
    "./feeds": "./routes/feeds.js",
    "./shell": "./render/shell.js",
    "./templates": "./render/templates.js",
    "./page": "./render/page.js",
    "./capture": "./capture/store.js",
    "./capture-admin": "./capture/admin.js",
    "./capture-routes": "./capture/routes.js",
    "./media": "./routes/media.js"
  },
  "imports": {
    "#schema": "./content/schema.js",
    "#loader": "./content/loader.js",
    "#repository": "./content/repository.js",
    "#transliterate": "./content/transliterate.js",
    "#taxonomy": "./content/taxonomy.js",
    "#markdown": "./content/markdown.js",
    "#sources": "./content/sources.js",
    "#html": "./render/html.js",
    "#document": "./render/document.js",
    "#sections": "./render/sections.js",
    "#editorial": "./render/editorial/index.js",
    "#routes": "./routes/index.js",
    "#feeds": "./routes/feeds.js",
    "#content-routes": "./routes/content-routes.js",
    "#shell": "./render/shell.js",
    "#templates": "./render/templates.js",
    "#page": "./render/page.js",
    "#capture": "./capture/store.js",
    "#capture-admin": "./capture/admin.js",
    "#capture-routes": "./capture/routes.js",
    "#media": "./routes/media.js"
  },
  "dependencies": {
    "@ti-engine/core": "*",
    "@ti-engine/web-framework": "*",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-bracketed-spans": "^1.0.3",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "files": [
    "content/",
    "render/",
    "routes/",
    "static/",
    "capture/",
    "design/",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belleal/ti-engine.git",
    "directory": "packages/web-content"
  },
  "bugs": {
    "url": "https://github.com/Belleal/ti-engine/issues"
  },
  "homepage": "https://github.com/Belleal/ti-engine/tree/master/packages/web-content#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
