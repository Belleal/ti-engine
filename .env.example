# ---------------------------------------------------------------------------
# competence — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets. Placeholders below are safe.
# ---------------------------------------------------------------------------

# --- Instance identity (defaults are baked into the image; override only if needed) ---
TI_INSTANCE_NAME=ti-competence
TI_INSTANCE_CLASS=bin/competence-web-server.js
TI_INSTANCE_CONFIG=bin/competence-web-server.json
TI_LOCALIZATION_LABELS_PATH=bin/localization/competence-labels.json
TI_AUDITING_LOG_MIN_LEVEL=0

# --- Web binding (container-friendly; a reverse proxy should terminate TLS) ---
# Keys are kept in alphabetical order so `dotenv-linter` stays quiet.
TI_WEB_APP_STATIC_CACHE_DISABLED=false
# Comma-separated admin allowlist; matched against the session user's ID, username or email.
# Set this to your own sign-in email BEFORE the first boot. Empty means no admins, and on an empty install an
# admin identity is the only way in: nobody has an employee record yet, so the admin exception is what keeps the
# configuration screens reachable. Comma-separated for more than one.
TI_WEB_AUTH_ADMINS=
# Which sign-in methods are offered. The image defaults to `openid-azure`; the dev compose stack defaults to
# `local`. Set it explicitly here to run the stack against a real identity provider.
TI_WEB_AUTH_METHODS=local
TI_WEB_HOST=0.0.0.0
TI_WEB_PORT=3000
TI_WEB_USE_TLS=false

# --- Redis (must have the JSON module: Redis Stack or Redis 8+) ---
TI_MEMORY_CACHE_REDIS_HOST=redis
TI_MEMORY_CACHE_REDIS_PORT=6379
TI_MEMORY_CACHE_REDIS_DB=0
TI_MEMORY_CACHE_AUTH_KEY=

# --- Secrets (set to strong random values in production) ---
# Generate each with: openssl rand -base64 48
# Replace the placeholders — a verbatim copy would use the literal text as the secret.
TI_MESSAGE_EXCHANGE_SECURITY_HASH_KEY=<set-a-strong-random-value>
TI_WEB_COOKIE_SECRET=<set-a-strong-random-value>

# --- Application flags ---
COMPETENCE_PRELOAD_DATA=false
COMPETENCE_TEST_USER_ENABLED=false

# --- Optional OAuth (leave unset to disable) ---
# A callback URL may be the absolute URL registered with the provider (as below) or just its path
# ("/login/azure-callback"). The absolute form is sent to the provider as the redirect_uri verbatim;
# the path form derives it from the X-Forwarded-Proto/Host headers your reverse proxy sets.
#
# SET ALL FOUR AZURE VALUES TOGETHER, OR NONE. A provider enabled but missing its CLIENT ID is dropped with a
# warning and the instance still starts — but that check looks at the client ID alone. A client ID with no
# discovery URL passes it and then fails during OpenID discovery, and the instance does not start at all.
#
# The discovery URL is built from your tenant ID:
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#TI_AZURE_AUTH_CLIENT_ID=<azure-client-id>
#TI_AZURE_AUTH_CLIENT_SECRET=<azure-client-secret>
#TI_AZURE_AUTH_CALLBACK_URL=https://your-host/login/azure-callback
#TI_AZURE_AUTH_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
#TI_GCLOUD_AUTH_CLIENT_ID=<google-client-id>
#TI_GCLOUD_AUTH_CLIENT_SECRET=<google-client-secret>
#TI_GCLOUD_AUTH_CALLBACK_URL=https://your-host/login/google-callback
